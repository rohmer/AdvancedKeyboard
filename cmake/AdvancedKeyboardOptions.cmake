include_guard(GLOBAL)
option(ADVKBD_BUILD_WIDGET "Build the LVGL 9.6 widget and public C facade" ON)
option(ADVKBD_BUILD_PREDICTION "Build native NGTR prediction/autocorrect support" ON)
option(ADVKBD_BUILTIN_MODEL "Include the small built-in English model" ON)
option(ADVKBD_ENABLE_PINYIN "Include Mandarin Pinyin composition data" OFF)
option(ADVKBD_SCRIPT_FONTS "Enable all bundled additional script fonts by default" OFF)
foreach(script HINDI BENGALI CYRILLIC GREEK URDU)
    option(ADVKBD_FONT_${script} "Include the bundled ${script} keyboard font" OFF)
endforeach()
if(DEFINED ADD_TO_LVGL AND NOT DEFINED ADVKBD_EMBED_IN_LVGL)
    set(ADVKBD_EMBED_IN_LVGL "${ADD_TO_LVGL}" CACHE BOOL "Compile widget sources directly into an existing LVGL target")
endif()
option(ADVKBD_EMBED_IN_LVGL "Compile widget sources directly into an existing LVGL target" OFF)
set(ADVKBD_LVGL_TARGET "" CACHE STRING "Existing LVGL target (auto: lvgl::lvgl or lvgl)")
set(ADVKBD_LVGL_SOURCE_DIR "" CACHE PATH "Optional explicit local LVGL checkout; never downloaded")
set(ADVKBD_BUNDLED_MODELS "none" CACHE STRING "Optional language:KiB model profiles, separated by semicolons; all or none")
set_property(CACHE ADVKBD_BUNDLED_MODELS PROPERTY STRINGS "none" "en-US:16" "fr-FR:16" "zh-CN:16" "all")
option(ADVKBD_BUILD_TOOLS "Build optional offline C++ model tools" OFF)
option(ADVKBD_BUILD_TESTS "Build native tests" OFF)
option(ADVKBD_BUILD_EXAMPLE "Build the small board-independent UI example" OFF)
