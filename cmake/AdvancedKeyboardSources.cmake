include_guard(GLOBAL)
get_filename_component(_ADVKBD_PACKAGE_ROOT "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)

function(advkbd_prediction_sources output)
    set(sources)
    foreach(name PredictionModel.cpp PredictionPrefix.cpp Utf8Fold.cpp PredictionStorage.cpp)
        list(APPEND sources "${_ADVKBD_PACKAGE_ROOT}/src/${name}")
    endforeach()
    set(${output} "${sources}" PARENT_SCOPE)
endfunction()

function(advkbd_widget_sources output)
    set(sources)
    foreach(name Key.cpp Keyboard.cpp TypingView.cpp SuggestionText.cpp AdvancedKeyboard.cpp
            TextareaInputMode.c KeyboardFont.c AdvancedKeyboardBuildChecks.c)
        list(APPEND sources "${_ADVKBD_PACKAGE_ROOT}/src/${name}")
    endforeach()
    if(ADVKBD_BUILD_PREDICTION)
        list(APPEND sources "${_ADVKBD_PACKAGE_ROOT}/src/Prediction.cpp")
    else()
        list(APPEND sources "${_ADVKBD_PACKAGE_ROOT}/src/Utf8Fold.cpp")
    endif()
    foreach(pair "HINDI|Hindi" "BENGALI|Bengali" "CYRILLIC|Cyrillic" "GREEK|Greek" "URDU|Urdu")
        string(REPLACE "|" ";" parts "${pair}")
        list(GET parts 0 option_name)
        list(GET parts 1 title)
        if(ADVKBD_SCRIPT_FONTS OR ADVKBD_FONT_${option_name})
            list(APPEND sources "${_ADVKBD_PACKAGE_ROOT}/src/Keyboard${title}Font.c")
        endif()
    endforeach()
    set(${output} "${sources}" PARENT_SCOPE)
endfunction()

function(advkbd_feature_definitions output)
    set(prediction 0)
    set(builtin 0)
    set(pinyin 0)
    set(registry 0)
    if(ADVKBD_BUILD_PREDICTION)
        set(prediction 1)
        if(ADVKBD_BUILTIN_MODEL)
            set(builtin 1)
        endif()
    endif()
    if(ADVKBD_ENABLE_PINYIN)
        set(pinyin 1)
    endif()
    if(ADVKBD_BUNDLED_MODELS AND NOT ADVKBD_BUNDLED_MODELS STREQUAL "none")
        set(registry 1)
    endif()
    set(definitions LVSERIAL_USE_ADVANCED_KEYBOARD_PREDICTION=${prediction}
        LVSERIAL_USE_ADVANCED_KEYBOARD_BUILTIN_TRIE=${builtin}
        LV_ADVANCED_KEYBOARD_USE_PINYIN=${pinyin} ADVKBD_HAS_BUNDLED_MODELS=${registry})
    foreach(script HINDI BENGALI CYRILLIC GREEK URDU)
        if(ADVKBD_SCRIPT_FONTS OR ADVKBD_FONT_${script})
            list(APPEND definitions LV_ADVANCED_KEYBOARD_USE_${script}_FONT=1)
        else()
            list(APPEND definitions LV_ADVANCED_KEYBOARD_USE_${script}_FONT=0)
        endif()
    endforeach()
    set(${output} "${definitions}" PARENT_SCOPE)
endfunction()

function(advkbd_registry_paths output_sources output_cpp output_report)
    set(sources)
    set(cpp)
    set(report)
    if(ADVKBD_BUNDLED_MODELS AND NOT ADVKBD_BUNDLED_MODELS STREQUAL "none")
        if(NOT ADVKBD_BUILD_PREDICTION)
            message(FATAL_ERROR "ADVKBD_BUNDLED_MODELS requires ADVKBD_BUILD_PREDICTION=ON")
        endif()
        set(cpp "${CMAKE_CURRENT_BINARY_DIR}/advanced_keyboard_models/bundled_models.generated.cpp")
        set(report "${CMAKE_CURRENT_BINARY_DIR}/advanced_keyboard_models/bundled-models.json")
        set(sources "${_ADVKBD_PACKAGE_ROOT}/src/BundledModels.cpp" "${cpp}")
    endif()
    set(${output_sources} "${sources}" PARENT_SCOPE)
    set(${output_cpp} "${cpp}" PARENT_SCOPE)
    set(${output_report} "${report}" PARENT_SCOPE)
endfunction()

# Call after idf_component_register in an IDF component: dependency-discovery
# script mode returns from that call before reaching non-scriptable commands.
function(advkbd_add_registry_rule cpp report)
    if(COMMAND idf_build_get_property)
        idf_build_get_property(python PYTHON)
    else()
        find_package(Python3 3.10 COMPONENTS Interpreter REQUIRED)
        set(python "${Python3_EXECUTABLE}")
    endif()
    set(generator "${_ADVKBD_PACKAGE_ROOT}/tools/models/generate_bundled_models.py")
    set(builder "${_ADVKBD_PACKAGE_ROOT}/tools/layout/build_ngtr_index.py")
    set(catalog "${_ADVKBD_PACKAGE_ROOT}/models/bundled/catalog.json")
    file(GLOB inputs CONFIGURE_DEPENDS "${_ADVKBD_PACKAGE_ROOT}/models/bundled/models/*.ngtr")
    get_filename_component(directory "${cpp}" DIRECTORY)
    add_custom_command(OUTPUT "${cpp}" "${report}"
        COMMAND "${CMAKE_COMMAND}" -E make_directory "${directory}"
        COMMAND "${python}" "${generator}" --catalog "${catalog}" --index-builder "${builder}"
            --models "${ADVKBD_BUNDLED_MODELS}" --output "${cpp}" --report "${report}"
        DEPENDS "${generator}" "${builder}" "${catalog}" ${inputs}
        VERBATIM)
endfunction()
