include("${CMAKE_CURRENT_LIST_DIR}/AdvancedKeyboardOptions.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/AdvancedKeyboardSources.cmake")
set(_advkbd_sources)
set(_advkbd_requirements)
set(_advkbd_private_includes "${_ADVKBD_PACKAGE_ROOT}/src" "${_ADVKBD_PACKAGE_ROOT}")
set(_advkbd_public_includes "${_ADVKBD_PACKAGE_ROOT}/include")
if(ADVKBD_BUILD_WIDGET)
    advkbd_widget_sources(_advkbd_widget_sources)
    list(APPEND _advkbd_sources ${_advkbd_widget_sources})
    list(APPEND _advkbd_requirements lvgl)
    advkbd_registry_paths(_advkbd_registry_sources _advkbd_registry_cpp _advkbd_registry_report)
    list(APPEND _advkbd_sources ${_advkbd_registry_sources})
else()
    list(APPEND _advkbd_public_includes "${_ADVKBD_PACKAGE_ROOT}/src")
    if(ADVKBD_BUNDLED_MODELS AND NOT ADVKBD_BUNDLED_MODELS STREQUAL "none")
        message(FATAL_ERROR "The bundled-model widget registry requires ADVKBD_BUILD_WIDGET=ON")
    endif()
endif()
if(ADVKBD_BUILD_PREDICTION)
    advkbd_prediction_sources(_advkbd_prediction_sources)
    list(APPEND _advkbd_sources ${_advkbd_prediction_sources})
endif()
if(NOT _advkbd_sources)
    message(FATAL_ERROR "Enable the AdvancedKeyboard widget or prediction engine for an IDF component")
endif()
idf_component_register(SRCS ${_advkbd_sources}
    INCLUDE_DIRS ${_advkbd_public_includes} PRIV_INCLUDE_DIRS ${_advkbd_private_includes}
    REQUIRES ${_advkbd_requirements} PRIV_REQUIRES heap)
target_compile_features(${COMPONENT_LIB} PUBLIC c_std_99 cxx_std_17)
target_compile_options(${COMPONENT_LIB} PRIVATE $<$<COMPILE_LANGUAGE:CXX>:-fexceptions>)
advkbd_feature_definitions(_advkbd_definitions)
target_compile_definitions(${COMPONENT_LIB} PUBLIC ${_advkbd_definitions})
if(NOT ADVKBD_BUILD_WIDGET)
    target_compile_definitions(${COMPONENT_LIB} PRIVATE ESPOS_KEYBOARD_HEADLESS_PREDICTION=1)
endif()
if(_advkbd_registry_cpp)
    advkbd_add_registry_rule("${_advkbd_registry_cpp}" "${_advkbd_registry_report}")
endif()
